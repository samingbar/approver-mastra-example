# Local educational simulation only. Never use these demo credentials on a shared server.
MODE=fixture
COMPANY_NAME=Rivian-inspired Loan Lab
ACCENT_COLOR="#b45309"
PORT=3000
# Published Docker host port; change this when another local app uses port 3000.
LOCAL_APP_PORT=3000
HOST=127.0.0.1
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
DATABASE_URL=postgres://loan_app:loan_demo@127.0.0.1:5432/loan_demo
DATABASE_ADMIN_URL=postgres://postgres:local_postgres@127.0.0.1:5432/loan_demo
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=loan-artifacts
S3_ACCESS_KEY=S3RVER
S3_SECRET_KEY=S3RVER
OCR_ACTIVITY_SLOTS=4
EXTRACTION_ACTIVITY_SLOTS=4
APPLICATION_ACTIVITY_SLOTS=16
MAX_ACTIVE_APPLICATIONS=200
